# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite cache
/.cache

# Local env
.env.local

files.zip

# Generated fund-pipeline intermediates (regenerable via `npm run funds:build`).
# NOTE: data/generated/fund-universe.json is intentionally NOT ignored — the
# website imports it at build time, so it must stay committed.
data/generated/fund-reference-data.json
data/generated/fund-review-queue.json
data/generated/fund-import-failures.json
