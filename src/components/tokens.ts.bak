import React from "react";

// ── Design tokens — sharp, red-accent (finance professional) ───────────────────
// Surface tokens are CSS variables so the whole app can switch light/dark themes.
export const T = {
  bg:      "var(--c-bg)",     // page background
  panel:   "var(--c-panel)",  // card/panel surface
  panel2:  "var(--c-panel2)", // input / hover background
  panel3:  "var(--c-panel3)", // selected / deeper tint
  line:    "var(--c-line)",   // hairline border
  line2:   "var(--c-line2)",  // stronger hairline / divider
  text:    "var(--c-text)",   // primary text
  dim:     "var(--c-dim)",    // secondary text
  muted:   "var(--c-muted)",  // placeholder / very muted
  // Accents are kept as HEX (constant across themes) because they're composed with
  // alpha suffixes (e.g. `${T.green}55`) and used inside SVG gradient ids — both of
  // which require a real hex value, not a CSS variable.
  blue:    "#DC2626",   // primary CHROME accent → red (logo, nav, advisor hub)
  blueD:   "#B91C1C",   // active / hover red
  blueL:   "var(--c-blueL)",   // light red tint for active states (themed, used directly)
  data:    "#0E7490",   // DATA accent → teal (charts, scores, fund series)
  dataD:   "#155E75",   // darker teal
  dataL:   "var(--c-dataL)",   // light teal tint (themed, used directly)
  cyan:    "#0891B2",   // secondary data accent
  amber:   "#B45309",   // rank / signal — bronze
  red:     "#DC2626",   // risk / negative (gains-losses only)
  green:   "#16A34A",   // positive
  gold:    "#B45309",   // #1 rank
} as const;

// UI / prose — Geist (sharp, thin, technical; not the AI-default geometric look)
export const ui: React.CSSProperties = {
  fontFamily: "'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
};

// Data / numbers / tickers — Geist Mono with tabular figures so columns align
export const mono: React.CSSProperties = {
  fontFamily: "'Geist Mono', 'SF Mono', Consolas, monospace",
  fontVariantNumeric: "tabular-nums",
};

export const chartTooltip = {
  contentStyle: {
    background: "var(--c-panel)",
    border: "1px solid var(--c-line)",
    borderRadius: 8,
    color: "var(--c-text)",
    fontSize: 12,
    fontFamily: "'Geist', sans-serif",
    boxShadow: "0 8px 24px rgba(0,0,0,0.18)",
  },
  labelStyle: { color: "var(--c-dim)", fontFamily: "'Geist', sans-serif" },
  itemStyle: { fontFamily: "'Geist Mono', monospace", fontSize: 12 },
};

export const cardStyle = (extra?: React.CSSProperties): React.CSSProperties => ({
  background: "var(--c-panel)",
  border: "1px solid var(--c-line)",
  borderRadius: 8,
  boxShadow: "none",
  ...extra,
});

// kept for backwards compat — no longer renders a visible gradient
export const cardHighlight: React.CSSProperties = { display: "none" };
